# =============================================================================
# Project: tetris
# Configurations: Debug
# =============================================================================

#############################################
# Minimal version of Ninja required by this file

ninja_required_version = 1.5


#############################################
# Set configuration variable for custom commands.

CONFIGURATION = Debug
# =============================================================================
# Include auxiliary files.


#############################################
# Include rules file.

include CMakeFiles/rules.ninja

# =============================================================================

#############################################
# Logical path to working directory; prefix for absolute paths.

cmake_ninja_workdir = /Users/anna/Documents/github/Tetris/build/

#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/Tetris/build && /usr/local/Cellar/cmake/3.24.2/bin/ccmake -S/Users/anna/Documents/github/Tetris -B/Users/anna/Documents/github/Tetris/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/Tetris/build && /usr/local/Cellar/cmake/3.24.2/bin/cmake --regenerate-during-build -S/Users/anna/Documents/github/Tetris -B/Users/anna/Documents/github/Tetris/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# /Users/anna/Documents/github/Tetris/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for EXECUTABLE target main


#############################################
# Order-only phony target for main

build cmake_object_order_depends_target_main: phony || macos/CMakeFiles/main.dir

build macos/CMakeFiles/main.dir/main.cpp.o: CXX_COMPILER__main_Debug /Users/anna/Documents/github/Tetris/macos/main.cpp || cmake_object_order_depends_target_main
  DEP_FILE = macos/CMakeFiles/main.dir/main.cpp.o.d
  FLAGS = -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7 -std=gnu++20
  OBJECT_DIR = macos/CMakeFiles/main.dir
  OBJECT_FILE_DIR = macos/CMakeFiles/main.dir
  TARGET_COMPILE_PDB = macos/CMakeFiles/main.dir/
  TARGET_PDB = macos/main.pdb


# =============================================================================
# Link build statements for EXECUTABLE target main


#############################################
# Link the executable macos/main

build macos/main: CXX_EXECUTABLE_LINKER__main_Debug macos/CMakeFiles/main.dir/main.cpp.o
  FLAGS = -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.1.sdk -mmacosx-version-min=15.7
  LINK_LIBRARIES = -lncurses
  OBJECT_DIR = macos/CMakeFiles/main.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = macos/CMakeFiles/main.dir/
  TARGET_FILE = macos/main
  TARGET_PDB = macos/main.pdb


#############################################
# Utility command for edit_cache

build macos/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/Tetris/build/macos && /usr/local/Cellar/cmake/3.24.2/bin/ccmake -S/Users/anna/Documents/github/Tetris -B/Users/anna/Documents/github/Tetris/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build macos/edit_cache: phony macos/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build macos/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/anna/Documents/github/Tetris/build/macos && /usr/local/Cellar/cmake/3.24.2/bin/cmake --regenerate-during-build -S/Users/anna/Documents/github/Tetris -B/Users/anna/Documents/github/Tetris/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build macos/rebuild_cache: phony macos/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build main: phony macos/main

